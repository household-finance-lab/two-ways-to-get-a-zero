. do "/var/folders/gh/09k67mdn3ks9zh6wymygw2880000gn/T//SD06348.000000"

. display _newline as text "  item  opts   %corr   %inc    %DK   acc|attempt  chance   diff"

  item  opts   %corr   %inc    %DK   acc|attempt  chance   diff

. local i = 0

. foreach v of local qitems {
  2.     local ++i
  3.     local k : word `i' of `qkeys'
  4.     local o : word `i' of `qopts'
  5.     quietly summarize wgt1
  6.     local tot = r(sum)
  7.     quietly summarize wgt1 if `v' == `k'
  8.     local wc = cond(r(N)==0, 0, r(sum))
  9.     quietly summarize wgt1 if !inlist(`v', `k', 98, 99)
 10.     local wx = cond(r(N)==0, 0, r(sum))
 11.     quietly summarize wgt1 if `v' == 98
 12.     local wd = cond(r(N)==0, 0, r(sum))
 13.     local acc    = 100 * `wc' / (`wc' + `wx')
 14.     local chance = 100 / `o'
 15.     display as text "  " %-4s "`v'" %5.0f `o' ///
>         as result %8.1f 100*`wc'/`tot' %7.1f 100*`wx'/`tot' %7.1f 100*`wd'/`tot' ///
>         %11.1f `acc' %8.1f `chance' %8.1f `acc'-`chance'
 16. }

. 
. * Distractor concentration. Under uniform random guessing, errors would spread
. * roughly evenly across the wrong options. Where a single distractor absorbs most
. * of them, the defensible phrasing is "consistent with systematic misunderstanding
. * rather than uniform random responding" — never "respondents misunderstand X".
. 
